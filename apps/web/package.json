		"@quoteblaze/types": "workspace:*",
		"bcryptjs": "^3.0.3",
		"csv-parse": "^7.0.3",
		"dotenv": "^18.0.8",
		"drizzle-orm": "^1.0.0-rc.5",
		"jose": "^6.2.12",
		"next": "^16.3.5",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
