
# Local-development environment
# Copy this file to `.env` at the repository root. The Next.js configuration and
# the database migration/seed scripts load that root-level file during local development.

# PostgreSQL connection string.
# For local development, this matches the credentials in docker-compose.yml.
# In production, set DATABASE_URL in the Vercel project's server-side environment
# variables to your Neon connection string (prefer Neon’s pooled connection string
# for the web app).
DATABASE_URL=postgres://quoteblaze:172115205@localhost:5432/quoteblaze

# Secret used to sign authentication session tokens. Must be at least 32 characters.
# Generate a fresh value with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Encryption key for company-specific OpenRouter API credentials stored in PostgreSQL.
# Must decode from base64 to exactly 32 bytes, generate with: openssl rand -base64 32
# Keep this value stable across app instances. Changing it without re-encrypting stored credentials will make existing company API keys unreadable.
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Public base URL sent to OpenRouter as the HTTP-Referer metadata header.
# Use http://localhost:3000 locally, set your canonical HTTPS app URL on Hosting service.
APP_URL=http://localhost:3000

# Fallback model used only when no model is configured for a company.
# Each company can choose its own compatible OpenRouter chat model in Settings.
# Company API keys are entered in the app and encrypted in the database, do not add a shared OPENROUTER_API_KEY here or expose provider keys through NEXT_PUBLIC_* vars.
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Safety override for seeding demo data when NODE_ENV=production.
# Keep false by default. Enable only for an isolated sample/demo database.
# Do NOT enable this globally for a database containing real customer data.
ALLOW_DEMO_SEED=false
